{
  "diagram": "usecase",
  "title": "Library System - Use Case Model",
  "system": "Library System",
  "elements": [
    {"id": "reader", "type": "actor", "name": "Reader", "primary": true},
    {"id": "lib", "type": "actor", "name": "Librarian", "primary": true},
    {"id": "clock", "type": "actor", "name": "Clock", "stereotype": "timer actor", "primary": true},
    {"id": "email", "type": "actor", "name": "Email Server", "stereotype": "system actor", "side": "right"},

    {"id": "uc_search", "type": "usecase", "name": "Search Book"},
    {"id": "uc_reserve", "type": "usecase", "name": "Reserve Book"},
    {"id": "uc_borrow", "type": "usecase", "name": "Borrow Book"},
    {"id": "uc_return", "type": "usecase", "name": "Return Book"},
    {"id": "uc_renew", "type": "usecase", "name": "Renew Loan"},

    {"id": "uc_title", "type": "usecase", "name": "Manage Book Titles"},
    {"id": "uc_copy", "type": "usecase", "name": "Manage Book Copies"},
    {"id": "uc_readers", "type": "usecase", "name": "Manage Readers"},
    {"id": "uc_fine", "type": "usecase", "name": "Process Overdue Fine"},

    {"id": "uc_remind", "type": "usecase", "name": "Send Due Date Reminder"}
  ],
  "relations": [
    {"type": "association", "from": "reader", "to": "uc_search"},
    {"type": "association", "from": "reader", "to": "uc_borrow"},
    {"type": "association", "from": "reader", "to": "uc_return"},
    {"type": "association", "from": "reader", "to": "uc_renew"},
    {"type": "extend", "from": "uc_reserve", "to": "uc_search", "condition": "no copy available"},

    {"type": "association", "from": "lib", "to": "uc_title"},
    {"type": "association", "from": "lib", "to": "uc_copy"},
    {"type": "association", "from": "lib", "to": "uc_readers"},
    {"type": "association", "from": "lib", "to": "uc_fine"},

    {"type": "association", "from": "clock", "to": "uc_remind"},
    {"type": "association", "from": "uc_remind", "to": "email"}
  ]
}
