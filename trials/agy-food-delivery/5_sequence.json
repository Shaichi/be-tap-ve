{
  "diagram": "sequence",
  "title": "Place Order Sequence",
  "useCase": "Place Order",
  "elements": [
    {"id": "cust", "type": "actor", "name": "Customer", "primary": true},
    {"id": "ui", "type": "object", "class": "CustomerInterface", "stereotype": "user interaction"},
    {"id": "ctrl", "type": "object", "class": "OrderControl", "stereotype": "state dependent control"},
    {"id": "pay", "type": "object", "class": "PaymentProxy", "stereotype": "proxy"},
    {"id": "ord", "type": "object", "class": "Order", "stereotype": "entity"}
  ],
  "messages": [
    {"from": "cust", "to": "ui", "name": "checkout(cart)", "seq": "1"},
    {"from": "ui", "to": "ctrl", "name": "placeOrder(cart)", "seq": "2"},
    {"from": "ctrl", "to": "pay", "name": "processPayment(amount)", "seq": "3"},
    {"from": "pay", "to": "ctrl", "name": "paymentSuccess", "seq": "4", "type": "reply"},
    {"from": "ctrl", "to": "ord", "name": "create", "seq": "5", "type": "create"},
    {"from": "ctrl", "to": "ui", "name": "orderPlaced", "seq": "6", "type": "reply"},
    {"from": "ui", "to": "cust", "name": "showSuccess()", "seq": "7", "type": "reply"}
  ]
}
