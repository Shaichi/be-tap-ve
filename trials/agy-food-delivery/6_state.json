{
  "diagram": "state",
  "title": "Order Control Statechart",
  "stateMachineOf": "OrderControl",
  "elements": [
    {"id": "init", "type": "initial"},
    {"id": "pending", "type": "state", "name": "Pending Confirmation"},
    {"id": "cancelled", "type": "state", "name": "Cancelled"},
    {"id": "confirmed", "type": "state", "name": "Confirmed"},
    {"id": "preparing", "type": "state", "name": "Preparing"},
    {"id": "delivering", "type": "state", "name": "Delivering"},
    {"id": "delivered", "type": "state", "name": "Delivered"},
    {"id": "final1", "type": "final"},
    {"id": "final2", "type": "final"}
  ],
  "relations": [
    {"type": "transition", "from": "init", "to": "pending", "event": "placeOrder"},
    {"type": "transition", "from": "pending", "to": "cancelled", "event": "cancelOrder"},
    {"type": "transition", "from": "cancelled", "to": "final1"},
    {"type": "transition", "from": "pending", "to": "confirmed", "event": "confirmOrder"},
    {"type": "transition", "from": "confirmed", "to": "preparing", "event": "prepareOrder"},
    {"type": "transition", "from": "preparing", "to": "delivering", "event": "deliverOrder"},
    {"type": "transition", "from": "delivering", "to": "delivered", "event": "deliveryComplete"},
    {"type": "transition", "from": "delivered", "to": "final2"}
  ]
}
