{
  "diagram": "screenflow",
  "title": "LMS - Screen Flow theo vai tro",
  "roles": {"admin": "orange", "manager": "purple", "teacher": "green", "student": "pink"},
  "root": "login",
  "elements": [
    {"id": "login", "type": "screen", "name": "User Login"},
