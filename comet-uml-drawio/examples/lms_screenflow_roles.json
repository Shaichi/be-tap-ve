    {"from": "mdash", "to": "questions", "side": "down"},
    {"from": "questions", "to": "question"},
    {"from": "mdash", "to": "quizzes", "side": "down"},
    {"from": "quizzes", "to": "quiz"},
    {"from": "mdash", "to": "materials", "side": "down"},
    {"from": "materials", "to": "material"},
    {"from": "mdash", "to": "assignments", "side": "down"},
    {"from": "assignments", "to": "aform"},
    {"from": "aform", "to": "rubric", "side": "right"},
    {"from": "mdash", "to": "classes", "side": "up"},
    {"from": "classes", "to": "class"},

    {"from": "cdash", "to": "tclass", "side": "up"},
    {"from": "tclass", "to": "student"},
    {"from": "tclass", "to": "submission"},
    {"from": "submission", "to": "grading"},
    {"from": "tclass", "to": "quiz"},
    {"from": "tclass", "to": "material"},
    {"from": "tclass", "to": "aform"},

    {"from": "cdash", "to": "pubpack", "side": "left"},
    {"from": "pubpack", "to": "checkout"},
    {"from": "cdash", "to": "mypack", "side": "down"},
    {"from": "cdash", "to": "sclass", "side": "down"},
    {"from": "sclass", "to": "lmat"},
    {"from": "cdash", "to": "qph", "side": "down"},
    {"from": "qph", "to": "qpd"},
    {"from": "qph", "to": "qrev", "tree": false},
    {"from": "qpd", "to": "qtake"},
