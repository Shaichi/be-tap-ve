    {"from": "adetail", "to": "wcode"},
    {"from": "adetail", "to": "wdiag"},
    {"from": "adetail", "to": "wtext"},
    {"from": "lmat", "to": "qtake", "tree": false},
    {"from": "lmat", "to": "qres", "tree": false},
    {"from": "lmat", "to": "qrev", "tree": false}
