{
  "diagram": "erd",
  "title": "Banking System - ERD",
  "elements": [
    {"id": "customer", "type": "entity", "name": "Customer", "attributes": [
      "PK customerId: INT", "customerName: VARCHAR(80)", "address: VARCHAR(200)", "phone: VARCHAR(15)"]},
    {"id": "holding", "type": "entity", "name": "AccountHolder", "attributes": [
      {"name": "customerId", "type": "INT", "key": "PK,FK"},
      {"name": "accountNumber", "type": "CHAR(12)", "key": "PK,FK"},
      {"name": "role", "type": "VARCHAR(20)"}]},
    {"id": "account", "type": "entity", "name": "Account", "attributes": [
      "PK accountNumber: CHAR(12)", "accountType: VARCHAR(10)", "balance: DECIMAL(15,2)"]},
    {"id": "card", "type": "entity", "name": "ATMCard", "attributes": [
      "PK cardId: CHAR(16)", "FK accountNumber: CHAR(12)", "pinHash: CHAR(64)", "expiryDate: DATE", "status: VARCHAR(10)"]},
    {"id": "atm", "type": "entity", "name": "ATM", "attributes": [
      "PK atmId: INT", "location: VARCHAR(120)", "cashAvailable: DECIMAL(12,2)"]},
    {"id": "txn", "type": "entity", "name": "ATMTransaction", "attributes": [
      "PK transactionId: BIGINT", "FK cardId: CHAR(16)", "FK atmId: INT", "txnType: VARCHAR(12)",
      "amount: DECIMAL(12,2)", "txnTime: TIMESTAMP"]}
  ],
  "relations": [
    {"type": "relationship", "from": "customer", "to": "holding", "fromCard": "1", "toCard": "1..*", "label": "holds"},
    {"type": "relationship", "from": "account", "to": "holding", "fromCard": "1", "toCard": "1..*", "label": "held by"},
    {"type": "relationship", "from": "account", "to": "card", "fromCard": "1", "toCard": "0..*", "label": "accessed by"},
    {"type": "relationship", "from": "card", "to": "txn", "fromCard": "1", "toCard": "0..*", "label": "used in"},
    {"type": "relationship", "from": "atm", "to": "txn", "fromCard": "1", "toCard": "0..*", "label": "records", "identifying": false}
  ]
}
